# Copie para .env e ajuste se necessário:  cp .env.example .env

# --- Banco analítico (Postgres do docker-compose) ---
POSTGRES_USER=analytics
POSTGRES_PASSWORD=analytics
POSTGRES_DB=analytics
POSTGRES_PORT=5433

# --- Metabase (usado apenas por dashboards/create_metabase_dashboard.py) ---
METABASE_URL=http://localhost:3000
METABASE_ADMIN_EMAIL=admin@example.com
# O Metabase exige senha "forte" (tamanho + variedade de caracteres)
METABASE_ADMIN_PASSWORD=Ch4nge-me-please-2026!
